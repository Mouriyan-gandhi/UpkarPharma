# Copy this to .env.local for local dev, or set in Vercel project settings for production.

# ─── Supabase (required) ─────────────────────────────────────────────────────
# Public URL + anon key are safe to expose to the browser (protected by RLS).
# service_role bypasses RLS — server-only, never ship to client.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct DB connection via session pooler (works over IPv4 without extra add-on).
# Used by ops scripts under scripts/. Password should be URL-encoded (# → %23).
SUPABASE_DB_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Legacy (still used by a few routes during the migration) ────────────────

# Admin dashboard session signing key.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# ─── Optional ────────────────────────────────────────────────────────────────

# Your public deployment URL — used for invoice links in WhatsApp notifications.
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# WhatsApp webhook (OpenWA / Baileys). If unset, notifications log to console only.
# OPENWA_WEBHOOK_URL=https://your-whatsapp-bot.example.com/send
