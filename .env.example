# Copy this to .env.local for local dev, or set in Railway dashboard for production.

# ─── Required ────────────────────────────────────────────────────────────────

# Admin dashboard session signing key. Must be set before deploying.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# Firebase service account — needed for Phone Auth OTP verification.
# Download from Firebase Console → Project Settings → Service Accounts → Generate new key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private_key value from the downloaded JSON (keep the \n line breaks).
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ─── Deployment ──────────────────────────────────────────────────────────────

# Path to the SQLite database file.
# On Railway: mount a volume at /data and set this to /data/database.sqlite
# Local dev: leave unset (defaults to ./database.sqlite in project root)
# DATABASE_PATH=/data/database.sqlite

# ─── Optional ────────────────────────────────────────────────────────────────

# Your public deployment URL — used for invoice links in WhatsApp notifications.
# On Railway: set to https://<your-service>.railway.app
# NEXT_PUBLIC_BASE_URL=https://your-app.railway.app

# WhatsApp webhook (OpenWA / Baileys). If unset, notifications log to console only.
# OPENWA_WEBHOOK_URL=https://your-whatsapp-bot.example.com/send
