# Copy this file to .env.local (dev) or set these in your VPS environment (prod).
# In production the app REFUSES TO START without JWT_SECRET (see src/lib/auth.ts).

# Secret used to sign/verify the admin dashboard session (admin_session JWT).
# Generate a strong value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
